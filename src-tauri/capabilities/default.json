{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "幕海移动端（安卓/iOS）默认权限：放行核心能力与自定义命令",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-on-back-button",
    "dialog:default",
    "fs:default",
    "notification:default",
    "allow-fetchsource",
    "allow-spiderrun",
    "allow-dlnascan",
    "allow-castvideo"
  ]
}
